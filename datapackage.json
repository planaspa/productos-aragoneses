      "format": "json",
      "mediatype": "application/json",
      "encoding": "utf-8"
    },
    {
      "name": "ecommerce-json",
      "title": "E-commerce (JSON)",
      "path": "docs/datos/ecommerce.json",
      "format": "json",
      "mediatype": "application/json",
      "encoding": "utf-8"
    }
